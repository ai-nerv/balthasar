# Stores a test run left behind. balthasar makes one wherever it is started, and the
# repository is not where it belongs.
/.store
/magi/
/balthasar/
# The same, named `<label>-<hash>` at the root (e.g. `tools_live-d29b16529e9723ca`): a test
# scope's store, where the 16-hex hash makes each run a new directory.
/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
